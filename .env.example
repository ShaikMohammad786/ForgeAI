# ForgeAI Environment Configuration
# Choose provider: auto | ollama | gemini | openai_compatible
FORGEAI_PROVIDER=ollama

# Local or Tunneled Ollama settings (no API key needed)
OLLAMA_HOST=http://127.0.0.1:11434
FORGEAI_OLLAMA_MODEL=qwen2.5:3b
FORGEAI_OLLAMA_JUDGE_MODEL=qwen2.5:1.5b

# Google Gemini API settings (used when provider=gemini or selected in UI)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
FORGEAI_GEMINI_MODEL=gemini-2.5-flash
FORGEAI_GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite
FORGEAI_GEMINI_USE_INTERACTIONS=true

# OpenAI-Compatible providers (Groq, OpenAI, OpenRouter, Hugging Face, Together, LM Studio, vLLM, llama.cpp)
FORGEAI_OPENAI_BASE_URL=
OPENAI_COMPAT_API_KEY=
FORGEAI_OPENAI_MODEL=gpt-4o-mini

# Embedding model (local ONNX via FastEmbed - no GPU VRAM required)
FORGEAI_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Default runtime & budget guardrails
FORGEAI_MAX_ITERATIONS=3
FORGEAI_MAX_TOKENS_BUDGET=400000
FORGEAI_MAX_SECONDS_BUDGET=1200
FORGEAI_MIN_GAIN_THRESHOLD=0.02
FORGEAI_EVAL_CASE_TARGET=24
